# Add these in Netlify: Site configuration > Environment variables.
# (For `npm run dev` on your own computer, copy this file to .env and export the values.)

# ---------- required ----------
# PostgreSQL connection string. A free Neon database works: copy its "connection string" (it includes ?sslmode=require).
DATABASE_URL=postgresql://user:password@ep-example-123456.eu-central-1.aws.neon.tech/neondb?sslmode=require
# At least 32 random characters. Generate one with:  openssl rand -base64 48
JWT_SECRET=
# Email account the invitations are sent from (any SMTP service: Gmail/Google Workspace, Microsoft 365, Brevo, Mailgun, SendGrid...)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Acme Workforce <workforce@yourcompany.co.ke>

# ---------- recommended ----------
# A code needed to complete first-time setup, so nobody else can claim your new site.
SETUP_TOKEN=
# Turn on once your office's public internet address is listed under Admin > Network zones.
ENFORCE_NETWORK=false

# ---------- optional ----------
# Netlify sets URL automatically; set PUBLIC_URL only if invitation links should use a different address (e.g. your custom domain before it is primary).
PUBLIC_URL=
# How often open screens check for changes (seconds). Each check is one function call; see "Costs" in the README.
POLL_SECONDS=15
SESSION_TTL_HOURS=12
INVITE_TTL_DAYS=7
MIN_PASSWORD_LENGTH=10
ALLOW_ACCEPT_OFF_NETWORK=true
# Shows an admin-only test clock for trying out shift ends and meal cut-offs. Never on in real use.
TEST_CONTROLS=false
