{
  "name": "unified-workforce-netlify",
  "version": "1.0.0",
  "private": true,
  "description": "UnifiedWorkforce on Netlify: the web app, an API function, scheduled email delivery, and a PostgreSQL database (Neon).",
  "scripts": {
    "build": "node scripts/build-web.js && node scripts/build-functions.mjs",
    "dev": "node scripts/build-web.js && ts-node --transpile-only scripts/dev-server.ts",
    "test": "node scripts/build-web.js && node scripts/build-functions.mjs && jest --runInBand --forceExit",
    "typecheck": "tsc --noEmit"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/test/**/*.spec.ts"
    ],
    "testTimeout": 30000
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.0.14",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@netlify/functions": "^6.0.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^29.5.14",
    "@types/jsdom": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.19.43",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "esbuild": "^0.28.2",
    "jest": "^29.7.0",
    "jsdom": "^24.1.3",
    "jspdf": "^2.5.1",
    "jspdf-autotable": "^3.8.2",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "typescript": "5.4"
  }
}
