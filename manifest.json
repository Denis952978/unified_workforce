{
  "manifest_version": 3,
  "name": "UnifiedWorkforce for Labelbox",
  "short_name": "UnifiedWorkforce",
  "version": "1.0.0",
  "description": "Counts your Labelbox work automatically: starts when you click Start labeling, adds each item you submit or review, and records active working time for your shift.",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_popup": "popup.html", "default_title": "UnifiedWorkforce", "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png" } },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["https://*.labelbox.com/*", "https://labelbox.com/*"], "js": ["content.js"], "run_at": "document_idle", "all_frames": true }
  ],
  "permissions": ["storage", "alarms"],
  "host_permissions": ["https://*.labelbox.com/*", "https://labelbox.com/*"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
  "storage": { "managed_schema": "managed_schema.json" }
}
